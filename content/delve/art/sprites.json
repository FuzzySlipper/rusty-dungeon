{
  "schema": "delve.art.sprites.v1",
  "description": "Maps content sprite ids to cells of donor sprite sheets staged under the gitignored content import area (delve/imports/art, produced by scripts/extract-delver-reference.sh). Sheets are fixed 32px grids; a cell index is column + row * columns, as in the donor's TextureAtlas. Monster cells and walk/attack ranges follow donor data/monsters.dat where a donor monster exists; rat, ogre and golem have no donor monster and borrow the worm, zombie and eye art. Sprites are lit through each sheet's normal sheet, derived offline by scripts/derive-sprite-normals.py; without staged normals they draw unlit. The art and its derivatives are donor-derived and never committed. Without staged art, actors keep their placeholder plates.",
  "artContentPrefix": "delve/imports/art",
  "lighting": { "mode": "authored-normal", "strength": 1.5 },
